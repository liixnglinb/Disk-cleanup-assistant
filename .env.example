# =============================================================================
# 本地工具箱 · 代码签名配置（占位模板）
# 复制为 .env 或按需设置进 CI 的 Secrets。切勿把真实证书提交到代码库！
# =============================================================================

# ---- 方式A：证书文件 + 密码（推荐，离线签名） ----
# 证书文件：《企业身份/代码签名》OV/EV 证书导出的 .pfx 或 .p12
SIGN_CERT_FILE=C:\secure\certs\your-code-signing.pfx
SIGN_CERT_PASSWORD=你的证书密码

# ---- 方式B：让 electron-builder 在 npm run dist 时自动签名（任选一种，优先） ----
# CSC_LINK=https://... 或 file:C:\secure\certs\your-code-signing.pfx
# CSC_KEY_PASSWORD=你的证书密码

# ---- 时间戳服务（RFC3161，正式版务必带时间戳，保证证书过期后签名仍有效） ----
SIGN_TIMESTAMP_URL=http://timestamp.digicert.com