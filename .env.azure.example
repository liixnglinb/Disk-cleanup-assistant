# =============================================================================
# 本地工具箱 · Azure Trusted Signing（云签名）环境变量模板
# 复制为 .env.azure 或写入 CI Secrets。切勿把账号/密钥提交进代码库。
# =============================================================================

# ---- Trusted Signing 账户信息（Azure 门户 -> Trusted Signing -> 签名账户） ----
AZURE_TRUSTED_SIGNING_ENDPOINT=https://wus2.codesigning.azure.net
AZURE_TRUSTED_SIGNING_ACCOUNT=你的签名账户名
AZURE_TRUSTED_SIGNING_PROFILE=你的证书配置文件名

# ---- 认证凭据（Microsoft Entra ID 应用主体，三选一下面任一组合） ----
# 方式1：客户端密钥
AZURE_TENANT_ID=你的目录(租户)ID
AZURE_CLIENT_ID=应用的客户端ID
AZURE_CLIENT_SECRET=应用客户端机密

# 方式2：客户端证书（替代 CLIENT_SECRET）
#AZURE_CLIENT_CERTIFICATE_PATH=C:\secure\entra-client-cert.pem
#AZURE_CLIENT_CERTIFICATE_PASSWORD=可选

# 方式3：用户名密码（不推荐生产）
#AZURE_USERNAME=你的账户
#AZURE_PASSWORD=你的密码

# ---- 可选：额外传给 Invoke-TrustedSigning 的参数（JSON 格式） ----
#AZURE_SIGNING_EXTRA_ARGS={"FileDigest":"SHA256"}