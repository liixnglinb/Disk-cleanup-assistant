# ---- 依赖 ----
node_modules/
.venv/

# ---- 构建产物 ----
dist/
backend_dist/
build/pyinstaller/
build/*.spec
build/azure-config.json
release/
*.exe
*.blockmap

# ---- 密钥 / 证书（永不入库） ----
.env
.env.azure
*.pfx
*.p12

# ---- 运行数据 ----
*.db
*.db-wal
*.db-shm
*.log

# ---- 测试临时目录 / 缓存 ----
__pycache__/
*.pyc
.pytest_cache/
tests_tmp/
tests_tmp_*/

# ---- 参考素材（历史 portal 快照，不入库） ----
meoo_portal/
meoo-*.png

# ---- electron-updater 本地调试配置 ----
dev-app-update.yml

# ---- 系统 / 编辑器 ----
.DS_Store
Thumbs.db

# ---- Electron / Chromium 运行日志（按 PID 落在仓库根，2026-10-04 实测 38 个）----
# 根目录四位数以上的纯数字文件名都是它写的 stderr 转储（含 viz_main_impl / crashpad 报错），
# 不是源码也不是数据；根治要在启动器里设 ELECTRON_LOG_FILE 指到日志目录。
/[0-9][0-9][0-9][0-9]*

# ---- 本地产物与取证（2026-10-04）----
/_archive/        # 306MB 构建产物与 pytest 缓存的本地存档
/shots/           # UI 取证截图（网站侧与本站都不引用，仅本地留档）
/shots3/
/settings-*.png
